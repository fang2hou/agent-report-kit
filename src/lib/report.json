            {
              "k": "基线",
              "v": "PR #1 合并后的 main（152e1d1）"
            },
            {
              "k": "令牌来源",
              "v": "html-report skill assets/template.html"
            }
          ]
        },
        {
          "type": "pair",
          "tr": "引用外语原文时，译文在前，原文保留原语言。",
          "orig": "他言語の引用は、翻訳を先に、原文は元の言語のまま残す。",
          "origLang": "ja"
        },
        {
          "type": "steps",
          "items": [
            "_agent_ 写 report.json，不写 HTML。",
            "渲染器按 lang 选择字体栈与界面文案。",
            "构建产出单文件 index.html，file:// 直接分发。"
          ]
        },
        {
          "type": "details",
          "summary": "验收命令与输出",
          "pre": "$ mise run check && pnpm build\n$ wc -c build/index.html"
        },
        {
          "type": "figure",
          "svg": "<svg viewBox=\"0 0 520 90\" role=\"img\" aria-label=\"渲染管线：JSON 到组件到单文件\" font-family=\"inherit\" font-size=\"15\"><g fill=\"none\" stroke=\"var(--color-line-2)\" stroke-width=\"1.5\"><rect x=\"1\" y=\"20\" width=\"120\" height=\"48\" rx=\"8\"/><rect x=\"200\" y=\"20\" width=\"120\" height=\"48\" rx=\"8\"/><rect x=\"399\" y=\"20\" width=\"120\" height=\"48\" rx=\"8\"/><path d=\"M121 44h79M320 44h79\" stroke=\"var(--color-accent)\"/></g><g fill=\"currentColor\" text-anchor=\"middle\"><text x=\"61\" y=\"49\">report.json</text><text x=\"260\" y=\"49\">组件库</text><text x=\"459\" y=\"49\">index.html</text></g></svg>",
          "caption": "图：渲染管线。纯客户端渲染，无服务器依赖。"
        }
      ]
    },
    {
      "heading": "权衡组件",
      "blocks": [
        {
          "type": "compare",
          "wide": true,
          "cards": [
            {
              "pick": true,
              "badge": "推荐",
              "heading": "继续组件库路线",
              "text": "agent 只写 JSON，渲染与主题由固定组件库保证。",
              "pros": ["正文与样式彻底分离", "多语言天然支持", "升级渲染器不改动历史报告"],
              "cons": ["初始组件开发成本已付", "schema 演进需要版本管理"]
            },
            {
              "heading": "回退单文件模板",
              "text": "每份报告继续由 agent 直接产出完整 HTML。",
              "pros": ["无需维护渲染器"],
              "cons": ["样式漂移无人拦截", "多语言靠手工", "体积与一致性不可控"]
            }
          ]
        }
      ]
    },
    {
      "heading": "多语言机制",
      "blocks": [
        {
          "type": "p",
          "text": "界面文案（结论、待决问题、提交、进度等）按 <code>report.lang</code> 查表，英文兜底；正文本身就是数据，不经过翻译层。"
        }
      ]
    },
    {
      "heading": "验收结论",
      "blocks": [
        {
          "type": "p",
          "text": "以上组件在 zh-CN 字体栈下与模板目视对齐后，本阶段即可合并；ja/en 构建抽查另做。"
        }
      ]
    }
  ],
